<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <mage_obsidian>
            <hmr>
                <enabled>1</enabled>
            </hmr>
            <dev_server>
                <host>localhost</host>
                <port>5173</port>
                <secure>0</secure>
                <hmr_path>/__vite_ping</hmr_path>
                <public_host>localhost</public_host>
                <allowed_hosts>localhost</allowed_hosts>
            </dev_server>
            <seo>
                <structured_data_enabled>1</structured_data_enabled>
            </seo>
            <checkout>
                <layout_mode>stepped</layout_mode>
                <cacheable_shell>0</cacheable_shell>
            </checkout>
            <storefront>
                <optimistic_ui>1</optimistic_ui>
            </storefront>
        </mage_obsidian>
        <!--
            Every inline script and stylesheet MageObsidian emits goes through
            SecureHtmlRenderer, and Magento only nonces (scripts) or hashes
            (styles) them when the configured policy disallows inline. Leaving
            core's default of 1 means the whole runtime is unreachable the moment
            a merchant enforces the policy. The mode stays report-only, so this
            tightens what is reported without blocking anything.
        -->
        <csp>
            <policies>
                <storefront>
                    <scripts>
                        <inline>0</inline>
                    </scripts>
                    <styles>
                        <inline>0</inline>
                    </styles>
                </storefront>
            </policies>
        </csp>
    </default>
</config>
