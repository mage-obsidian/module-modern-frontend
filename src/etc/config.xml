<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <mage_obsidian>
            <hmr>
                <enabled>0</enabled>
            </hmr>
            <dev_server>
                <host>localhost</host>
                <port>5173</port>
                <secure>0</secure>
                <hmr_path>/__vite_ping</hmr_path>
                <public_host>localhost</public_host>
                <allowed_hosts>localhost</allowed_hosts>
            </dev_server>
            <seo>
                <structured_data_enabled>1</structured_data_enabled>
                <webpage_enabled>1</webpage_enabled>
                <organization_contact_type>customer support</organization_contact_type>
                <organization_address_enabled>1</organization_address_enabled>
                <product_brand_attribute>manufacturer</product_brand_attribute>
                <product_condition>NewCondition</product_condition>
                <product_image_limit>3</product_image_limit>
                <price_valid_until_days>0</price_valid_until_days>
            </seo>
            <checkout>
                <layout_mode>stepped</layout_mode>
                <cacheable_shell>0</cacheable_shell>
            </checkout>
            <head>
                <includes_defer_scripts>0</includes_defer_scripts>
                <includes_defer_styles>0</includes_defer_styles>
            </head>
            <storefront>
                <optimistic_ui>1</optimistic_ui>
                <island_preload>0</island_preload>
            </storefront>
        </mage_obsidian>
        <!--
            Every inline script and stylesheet MageObsidian emits goes through
            SecureHtmlRenderer, and Magento only nonces (scripts) or hashes
            (styles) them when the configured policy disallows inline. Leaving
            core's default of 1 means the whole runtime is unreachable the moment
            a merchant enforces the policy.
        -->
        <csp>
            <policies>
                <storefront>
                    <scripts>
                        <inline>0</inline>
                    </scripts>
                    <styles>
                        <inline>0</inline>
                    </styles>
                </storefront>
                <storefront_checkout_index_index>
                    <styles>
                        <inline>1</inline>
                    </styles>
                </storefront_checkout_index_index>
                <storefront_multishipping_checkout_billing>
                    <styles>
                        <inline>1</inline>
                    </styles>
                </storefront_multishipping_checkout_billing>
            </policies>
        </csp>
    </default>
</config>
