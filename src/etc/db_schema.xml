<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="cms_page">
        <column xsi:type="smallint" name="mage_obsidian_skip_css_scan" unsigned="true" nullable="false"
                identity="false" default="0"
                comment="Exclude this content from the MageObsidian CSS scan"/>
    </table>
    <table name="cms_block">
        <column xsi:type="smallint" name="mage_obsidian_skip_css_scan" unsigned="true" nullable="false"
                identity="false" default="0"
                comment="Exclude this content from the MageObsidian CSS scan"/>
    </table>
</schema>
