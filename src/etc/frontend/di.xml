<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="pageLayoutFileSourceBaseFiltered">
        <arguments>
            <argument name="moduleManager" xsi:type="object">MageObsidian\ModernFrontend\Framework\Module\Manager
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="layoutFileSourceBaseFiltered">
        <arguments>
            <argument name="moduleManager" xsi:type="object">MageObsidian\ModernFrontend\Framework\Module\Manager
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="pageFileSourceBase">
        <arguments>
            <argument name="moduleManager" xsi:type="object">MageObsidian\ModernFrontend\Framework\Module\Manager
            </argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Asset\ConfigInterface">
        <plugin name="mageObsidian_skipMinifyHtmlForObsidianThemes"
                type="MageObsidian\ModernFrontend\Plugin\View\Asset\MinifyHtmlThemePlugin"/>
    </type>
    <type name="MageObsidian\ModernFrontend\Plugin\View\Asset\MinifyHtmlThemePlugin">
        <arguments>
            <argument name="design" xsi:type="object">Magento\Framework\View\DesignInterface\Proxy</argument>
        </arguments>
    </type>
    <type name="Magento\Theme\Controller\Result\AsyncCssPlugin">
        <plugin name="mageObsidian_skipAsyncCssForObsidianThemes"
                type="MageObsidian\ModernFrontend\Plugin\View\Result\AsyncCssThemePlugin"/>
    </type>
    <type name="Magento\Csp\Api\ModeConfigManagerInterface">
        <plugin name="mageObsidian_forceReportOnlyCspInHmr"
                type="MageObsidian\ModernFrontend\Plugin\Csp\ForceReportOnlyInHmr"/>
    </type>
    <type name="Magento\Csp\Model\Collector\ConfigCollector">
        <plugin name="mageObsidian_applyStrictInlinePolicy"
                type="MageObsidian\ModernFrontend\Plugin\Csp\ApplyStrictInlinePolicy"/>
    </type>
    <type name="MageObsidian\ModernFrontend\Plugin\Csp\ApplyStrictInlinePolicy">
        <arguments>
            <argument name="inlineStylePages" xsi:type="array">
                <item name="checkout" xsi:type="string">checkout_index_index</item>
                <item name="multishipping_billing" xsi:type="string">multishipping_checkout_billing</item>
            </argument>
        </arguments>
    </type>
    <type name="MageObsidian\ModernFrontend\Service\Csp\PaymentPages">
        <arguments>
            <argument name="fallbackActions" xsi:type="array">
                <item name="checkout_index_index" xsi:type="string">checkout_index_index</item>
                <item name="checkout_onepage_success" xsi:type="string">checkout_onepage_success</item>
                <item name="multishipping_checkout_billing" xsi:type="string">multishipping_checkout_billing</item>
            </argument>
        </arguments>
    </type>
    <type name="MageObsidian\ModernFrontend\Service\Theme\ObsidianThemeDetector">
        <arguments>
            <argument name="design" xsi:type="object">Magento\Framework\View\DesignInterface\Proxy</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Page\Config">
        <plugin name="mageObsidian_nonBlockingHeadIncludes"
                type="MageObsidian\ModernFrontend\Plugin\View\Page\Config\NonBlockingIncludes"/>
    </type>
</config>
