<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="MageObsidian\ModernFrontend\Block\Cms\DeltaStylesheet"
                   name="mage_obsidian.cms_delta_stylesheet"/>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="MageObsidian\ModernFrontend\Block\I18nRuntime"
                   name="mage_obsidian.i18n_runtime"/>
            <block class="MageObsidian\ModernFrontend\Block\SectionDataRuntime"
                   name="mage_obsidian.section_data_runtime"/>
            <block class="MageObsidian\ModernFrontend\Block\IconRuntime"
                   name="mage_obsidian.icon_runtime"/>
            <block class="MageObsidian\ModernFrontend\Block\IslandsRuntime"
                   name="mage_obsidian.islands_runtime"/>
            <block class="MageObsidian\ModernFrontend\Block\DevServerGuard"
                   name="mage_obsidian.dev_server_guard"/>
            <block class="MageObsidian\ModernFrontend\Block\SchemaOrgRuntime"
                   name="mage_obsidian.schema_org_runtime"/>
        </referenceContainer>
    </body>
</page>
